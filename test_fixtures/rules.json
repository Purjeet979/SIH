{
  "rules": [
    {
      "name": "Missing MRP",
      "conditions": {
        "all": [
          { "fact": "mrp", "operator": "equal", "value": false }
        ]
      },
      "event": {
        "type": "violation",
        "params": {
          "rule_id": "rule_6_1_e",
          "rule_number": "6(1)(e)",
          "title": "Missing Retail Sale Price (MRP)",
          "severity": "major",
          "description": "MRP must be clearly printed inclusive of all taxes."
        }
      }
    },
    {
      "name": "Missing Best Before (Perishable)",
      "conditions": {
        "all": [
          { "fact": "category", "operator": "equal", "value": "packaged_food" },
          { "fact": "best_before_or_use_by", "operator": "equal", "value": false }
        ]
      },
      "event": {
        "type": "violation",
        "params": {
          "rule_id": "rule_6_1_da",
          "rule_number": "6(1)(da)",
          "title": "Missing Best Before Date",
          "severity": "critical",
          "description": "Packaged food must declare Best Before or Use By date."
        }
      }
    },
    {
      "name": "Missing Veg/Non-Veg (Only for Packaged Food)",
      "conditions": {
        "all": [
          { "fact": "category", "operator": "equal", "value": "packaged_food" },
          { "fact": "veg_nonveg_mark", "operator": "equal", "value": false }
        ]
      },
      "event": {
        "type": "violation",
        "params": {
          "rule_id": "veg_mark",
          "rule_number": "FSSAI / LMPC",
          "title": "Missing Veg/Non-Veg Mark",
          "severity": "major",
          "description": "Required for consumables (Packaged Food)."
        }
      }
    },
    {
      "name": "Rule 7 Font Height Violation (Area < 50)",
      "conditions": {
        "all": [
          { "fact": "pdp_area_cm2", "operator": "lessThan", "value": 50 },
          { "fact": "font_height_mm", "operator": "lessThan", "value": 1.0 }
        ]
      },
      "event": {
        "type": "violation",
        "params": {
          "rule_id": "rule_7_small",
          "rule_number": "7(1)",
          "title": "Font Height Too Small (Area < 50 sq cm)",
          "severity": "major",
          "description": "Font height must be at least 1.0mm for Area < 50 cm²"
        }
      }
    },
    {
      "name": "Rule 7 Font Height Violation (50 <= Area < 2500)",
      "conditions": {
        "all": [
          { "fact": "pdp_area_cm2", "operator": "greaterThanInclusive", "value": 50 },
          { "fact": "pdp_area_cm2", "operator": "lessThan", "value": 2500 },
          { "fact": "font_height_mm", "operator": "lessThan", "value": 2.0 }
        ]
      },
      "event": {
        "type": "violation",
        "params": {
          "rule_id": "rule_7_medium",
          "rule_number": "7(1)",
          "title": "Font Height Too Small (50-2500 sq cm)",
          "severity": "major",
          "description": "Font height must be at least 2.0mm for Area 50-2500 cm²"
        }
      }
    }
  ]
}
