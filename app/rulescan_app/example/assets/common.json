{
  "rules": [
    { "name": "Missing Manufacturer Address", "conditions": { "all": [ { "fact": "manufacturer_address", "operator": "equal", "value": false } ] }, "event": { "type": "violation", "params": { "rule_id": "rule_6_1_a", "rule_number": "6(1)(a)", "title": "Missing Manufacturer Address", "severity": "major", "description": "Name and address of manufacturer must be declared." } } },
    { "name": "Missing Commodity Name", "conditions": { "all": [ { "fact": "commodity_name", "operator": "equal", "value": false } ] }, "event": { "type": "violation", "params": { "rule_id": "rule_6_1_b", "rule_number": "6(1)(b)", "title": "Missing Generic Commodity Name", "severity": "major", "description": "The common or generic name of the commodity must be mentioned." } } },
    { "name": "Missing Net Quantity", "conditions": { "all": [ { "fact": "net_quantity", "operator": "equal", "value": false } ] }, "event": { "type": "violation", "params": { "rule_id": "rule_6_1_c", "rule_number": "6(1)(c)", "title": "Missing Net Quantity", "severity": "major", "description": "Net quantity in standard units must be mentioned." } } },
    { "name": "Missing Manufacture Date", "conditions": { "all": [ { "fact": "manufacture_date", "operator": "equal", "value": false } ] }, "event": { "type": "violation", "params": { "rule_id": "rule_6_1_d", "rule_number": "6(1)(d)", "title": "Missing Manufacture Date", "severity": "major", "description": "Month and year of manufacture must be mentioned." } } },
    { "name": "Missing MRP", "conditions": { "all": [ { "fact": "mrp", "operator": "equal", "value": false } ] }, "event": { "type": "violation", "params": { "rule_id": "rule_6_1_e", "rule_number": "6(1)(e)", "title": "Missing Retail Sale Price (MRP)", "severity": "major", "description": "MRP must be clearly printed inclusive of all taxes." } } },
    { "name": "Missing Consumer Care Contact", "conditions": { "all": [ { "fact": "consumer_care_contact", "operator": "equal", "value": false } ] }, "event": { "type": "violation", "params": { "rule_id": "rule_6_2", "rule_number": "6(2)", "title": "Missing Consumer Care Contact", "severity": "minor", "description": "Contact details for consumer complaints must be provided." } } },
    { "name": "Rule 7 Font Height Violation (Area < 50)", "conditions": { "all": [ { "fact": "pdp_area_cm2", "operator": "lessThan", "value": 50 }, { "fact": "font_height_mm", "operator": "lessThan", "value": 1.0 }, { "fact": "font_height_mm", "operator": "greaterThanInclusive", "value": 0.01 } ] }, "event": { "type": "violation", "params": { "rule_id": "rule_7_small", "rule_number": "7(1)", "title": "Font Height Too Small (Area < 50 sq cm)", "severity": "major", "description": "Font height must be at least 1.0mm for Area < 50 cm²" } } },
    { "name": "Rule 7 Font Height Violation (50 <= Area < 2500)", "conditions": { "all": [ { "fact": "pdp_area_cm2", "operator": "greaterThanInclusive", "value": 50 }, { "fact": "pdp_area_cm2", "operator": "lessThan", "value": 2500 }, { "fact": "font_height_mm", "operator": "lessThan", "value": 2.0 }, { "fact": "font_height_mm", "operator": "greaterThanInclusive", "value": 0.01 } ] }, "event": { "type": "violation", "params": { "rule_id": "rule_7_medium", "rule_number": "7(1)", "title": "Font Height Too Small (50-2500 sq cm)", "severity": "major", "description": "Font height must be at least 2.0mm for Area 50-2500 cm²" } } }
  ]
}
